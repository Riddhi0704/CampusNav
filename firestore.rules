rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
match /campus_locations/{locationId} {
  allow read: if request.auth != null;
  allow create, update, delete: if isAdmin();
}

    // -----------------------------
// USERS
match /users/{userId} {

  // Logged-in users can read user profiles
  allow read: if request.auth != null;

  // Normal users can create only their own Student profile.
  // Admins can create any user profile.
  allow create: if request.auth != null &&
    (
      isAdmin() ||
      (
        request.auth.uid == userId &&
        request.resource.data.role == 'Student'
      )
    );

  // Admins can update anyone.
  // Normal users can update only their own profile,
  // but they cannot change their role.
  allow update: if request.auth != null &&
    (
      isAdmin() ||
      (
        request.auth.uid == userId &&
        request.resource.data.role == resource.data.role
      )
    );

  // Only Admins can delete user profiles
  allow delete: if isAdmin();
}  
 // -----------------------------
// DEPARTMENTS
// -----------------------------
match /departments/{departmentId} {
  allow read: if request.auth != null;

  allow create, update, delete: if isAdmin();
}

    // -----------------------------
    // LOCATIONS
    // -----------------------------
    match /locations/{locationId} {
      // Students/faculty/visitors can read campus locations.
      allow read: if request.auth != null;

      // Only admins can modify campus locations.
      allow create, update, delete: if isAdmin();
    }

    // -----------------------------
    // BUILDINGS
    // -----------------------------
    match /buildings/{buildingId} {
      allow read: if request.auth != null;

      allow create, update, delete: if isAdmin();
    }

    // -----------------------------
    // QR CODES
    // -----------------------------
    match /qr_codes/{qrId} {
      allow read: if request.auth != null;

      allow create, update, delete: if isAdmin();
    }

    // -----------------------------
    // ADMIN CHECK
    // -----------------------------
    function isAdmin() {
      return request.auth != null &&
        exists(
          /databases/$(database)/documents/users/$(request.auth.uid)
        ) &&
        get(
          /databases/$(database)/documents/users/$(request.auth.uid)
        ).data.role == 'Admin';
    }
  }
}